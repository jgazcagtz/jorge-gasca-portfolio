{
  "name": "jorge-gasca-portfolio",
  "version": "0.1.0",
  "private": true,
  "description": "Bilingual portfolio for product UX, sales and CRM automation, AI workflows, and hands-on product delivery.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:content": "vitest run tests/content.test.ts",
    "cv:pdf": "node scripts/generate-cv-pdfs.mjs",
    "test:cv": "node scripts/verify-cv-pdfs.mjs",
    "test:links": "node scripts/check-external-links.mjs",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "verify": "npm run lint && npm run typecheck && npm run test:content && npm run test:cv && npm run test:links && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "typescript": "^5",
    "vitest": "4.1.10"
  }
}
